# Copy to .env in the project root and replace this value.
RATEMATE_DB_PASSWORD=replace-with-a-local-development-password

# Local development sends verification codes to Mailpit at http://localhost:8025.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_SSL=false
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ratemate@localhost

# To send real mail with QQ, set EMAIL_HOST=smtp.qq.com, EMAIL_PORT=465,
# EMAIL_USE_SSL=true, EMAIL_HOST_USER=user-63aebf0e1dd0@example.invalid,
# EMAIL_HOST_PASSWORD=<QQ SMTP authorization code> and
# DEFAULT_FROM_EMAIL=user-63aebf0e1dd0@example.invalid in the ignored root .env.
