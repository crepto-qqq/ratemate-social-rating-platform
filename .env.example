# Copy to .env in the project root and replace this value.
RATEMATE_DB_PASSWORD=replace-with-a-local-development-password

# Local development sends verification codes to Mailpit at http://localhost:8025.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_SSL=false
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ratemate@localhost

# For real Gmail delivery, see the step-by-step guide in DOCKER.md.
# Set EMAIL_HOST_USER and DEFAULT_FROM_EMAIL to the sending Gmail address.
# EMAIL_HOST_PASSWORD must be a Google app password, never the Gmail sign-in password.
# Keep the real password in the ignored root .env; do not commit or share it.
