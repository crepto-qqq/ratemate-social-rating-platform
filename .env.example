# Copy to .env in the project root and replace this value.
RATEMATE_DB_PASSWORD=replace-with-a-local-development-password

# Local development sends verification codes to Mailpit at http://localhost:8025.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_SSL=false
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ratemate@localhost

# To send real mail with Gmail, set EMAIL_HOST=smtp.gmail.com,
# EMAIL_PORT=587, EMAIL_USE_TLS=true, EMAIL_HOST_USER=user-54cafa86e8ca@example.invalid,
# EMAIL_HOST_PASSWORD=<Google app password> and
# DEFAULT_FROM_EMAIL=user-54cafa86e8ca@example.invalid in the ignored root .env.
